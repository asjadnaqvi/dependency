# Ignore everything by default so only the deployment app and GitHub workflow are tracked.
*

# Allow GitHub workflow files needed for Pages deployment.
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Keep the deployment app tracked.
!dependency/
!dependency/**

# Keep the repo README if desired.
!README.md

# Common local noise
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
